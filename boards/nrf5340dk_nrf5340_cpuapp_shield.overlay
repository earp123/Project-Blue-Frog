/*
 * Rev 2 shield (OLED + microSD + Wio-SX1262) on the nRF5340 DK, 3.3 V: the
 * front end for the TDMA field variant (CONFIG_APP_TDMA_FIELD).
 *
 * Additive to the auto-applied radio overlay (nrf5340dk_nrf5340_cpuapp.overlay:
 * SX1262 on spi2 / port 1, unchanged). Like the display overlay, this one must
 * be passed explicitly via EXTRA_DTC_OVERLAY_FILE, with
 * boards/nrf5340dk_nrf5340_cpuapp_shield.conf.
 *
 *   microSD         spi4  SCK P1.14 (D12), MOSI P1.13 (D11), MISO P1.15 (D13),
 *                         CS P1.11 (D9), card-detect P1.12 (D10)
 *   SSD1306 128x64  i2c1  SDA P0.25 (A4), SCL P0.26 (A5), RST P0.07 (A3), 0x3C
 *
 * Pins as the shield's fabrication data routes them (ODB++ netlist in
 * Hardware/OLED-SD-SX1262-Shield_2026-08-16.zip): the socket's SCLK is on D12
 * and DO on D13, the OLED header on A4/A5, and the R3 header's dedicated
 * SDA/SCL pins are unconnected. Confirmed on the bench 2026-09-24: the
 * SSD1306 ACKs at 0x3C here, and the card mounts with SCK P1.14 / MISO P1.15
 * (the swapped mapping, which is the DK's own arduino_spi, does not). An
 * SD "disk" failure with this mapping means the card is not seated: DET
 * reads raw 1 until the push-push socket clicks.
 *
 * The TFT/touch front end (display overlay: P0.10, P0.13-18, P0.28-31) is not
 * used by this variant, so the DK LEDs on P0.28-31 are free again.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	chosen {
		zephyr,display = &ssd1306;
	};

	/*
	 * microSD card-detect, read by the application as a plain GPIO. It is
	 * not wired into the SD driver. The socket's CD1 pad has a 100 k
	 * pull-up (R3) and a capacitor to GND on the shield; its CD2 pad is
	 * unconnected, but the switch still pulls CD1 low with a card in.
	 * ACTIVE_LOW confirmed on the bench 2026-09-24: raw 0 with a card
	 * seated, raw 1 with it out. This node merges with the radio overlay's
	 * rf-sw-gpios.
	 */
	zephyr,user {
		sd-det-gpios = <&gpio1 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};

&pinctrl {
	spi4_sd_default: spi4_sd_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK,  1, 14)>,
				<NRF_PSEL(SPIM_MOSI, 1, 13)>,
				<NRF_PSEL(SPIM_MISO, 1, 15)>;
		};
	};

	spi4_sd_sleep: spi4_sd_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK,  1, 14)>,
				<NRF_PSEL(SPIM_MOSI, 1, 13)>,
				<NRF_PSEL(SPIM_MISO, 1, 15)>;
			low-power-enable;
		};
	};

	/*
	 * The shield has no pull-ups on SDA/SCL. Most SSD1306 modules carry
	 * their own; the internal ~13 k pull-ups here are a fallback for
	 * modules that do not. If the display is flaky and the module has no
	 * pull-ups of its own, drop clock-frequency to I2C_BITRATE_STANDARD:
	 * 13 k is too weak for fast-mode rise times.
	 */
	i2c1_oled_default: i2c1_oled_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 25)>,
				<NRF_PSEL(TWIM_SCL, 0, 26)>;
			bias-pull-up;
		};
	};

	i2c1_oled_sleep: i2c1_oled_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 25)>,
				<NRF_PSEL(TWIM_SCL, 0, 26)>;
			low-power-enable;
		};
	};
};

&spi4 {
	status = "okay";
	pinctrl-0 = <&spi4_sd_default>;
	pinctrl-1 = <&spi4_sd_sleep>;
	pinctrl-names = "default", "sleep";

	cs-gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;	/* reg 0: SD card */

	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		/*
		 * Copied verbatim from the display overlay. These two values are
		 * the fix for the 2026-07-31 enumeration failures, so do not
		 * "tidy" them back to the binding defaults.
		 *
		 * 4 MHz, not the bus maximum. The soak logger's worst case is
		 * ~3.2 KB/s (50 records/s of 64 B at the 20 ms slot), which
		 * leaves two orders of magnitude of headroom. Card init runs at
		 * 400 kHz regardless; this is the post-init transfer clock.
		 */
		spi-max-frequency = <4000000>;
		/*
		 * The binding's 1 ms default is not enough for a large SDXC card
		 * to come up. Init then fails intermittently with ENOTSUP or
		 * ETIMEDOUT. The SD spec allows a card up to 250 ms after power
		 * before it must answer.
		 */
		power-delay-ms = <250>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_oled_default>;
	pinctrl-1 = <&i2c1_oled_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_FAST>;
	/*
	 * The SSD1306 driver sends each frame as two messages: a 1-byte
	 * control prefix, then all 1024 pixel bytes. TWIM cannot chain
	 * them, so the driver merges them in this RAM buffer, which
	 * defaults to 16 bytes. With the default, every frame write
	 * failed on the bench (2026-09-24): init commands ACKed, the
	 * screen stayed blank.
	 */
	zephyr,concat-buf-size = <1025>;

	/* From Zephyr's boards/shields/ssd1306/ssd1306_128x64.overlay, plus the
	 * shield's reset line.
	 */
	ssd1306: ssd1306@3c {
		compatible = "solomon,ssd1306fb";
		reg = <0x3c>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		segment-remap;
		com-invdir;
		prechargep = <0x22>;
		reset-gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
	};
};
