# Application configuration.
#
# One firmware per unit type on the bench. Exactly one is built at a time,
# selected by that unit's companion conf, which is always applied together
# with its overlay (see README.md, "Building and flashing"):
#
#   TFT unit     boards/nrf5340dk_nrf5340_cpuapp_tft.{overlay,conf}
#   shield unit  boards/nrf5340dk_nrf5340_cpuapp_shield.{overlay,conf}
#
# Both run the same TDMA radio layer (src/tdma) and log soaks to SD.

choice
	prompt "Unit type"
	help
	  Set by the unit's companion conf. CMakeLists.txt stops the build if
	  the choice and the devicetree front end do not match.

config APP_TDMA_CONSOLE
	bool "TFT unit: TDMA field console (ILI9341 + touch + microSD)"
	select COUNTER
	help
	  Field-test console for the TDMA radio layer on the TFT breakout:
	  ILI9341 display, XPT2046 touch and microSD on spi4 / port 0, with the
	  radio shield on spi2 / port 1. Apply
	  boards/nrf5340dk_nrf5340_cpuapp_tft.overlay and
	  boards/nrf5340dk_nrf5340_cpuapp_tft.conf. Soak tests of the continuous
	  TX/RX frame exchange with live link telemetry on the TFT. The unit
	  (MASTER in slot 0, or SEC 1-3) is picked at boot, so one image serves
	  every unit. All PHY parameters are compile-time constants in tdma.h
	  except TX power. Display-only: no UART, logging, or shell.

config APP_TDMA_FIELD
	bool "Shield unit: TDMA field unit (rev 2 shield: OLED + microSD)"
	select COUNTER
	help
	  The same soak runner on the rev 2 shield: an SSD1306 128x64 OLED on
	  i2c1, a microSD card on spi4, and the SX1262 on spi2 / port 1. Apply
	  boards/nrf5340dk_nrf5340_cpuapp_shield.overlay and
	  boards/nrf5340dk_nrf5340_cpuapp_shield.conf. Buttons only, with an
	  essentials-only cycle UI: unit (MASTER in slot 0, or SEC 1-3) at
	  boot, then soak, TX power and an SD summary. UART logging stays on for
	  bring-up.

endchoice

config SOAK_PAYLOAD_TONE
	bool "Soak payload: per-slot PCM tone instead of the ramp"
	help
	  Fill each soak transmission with 40 samples of an 8 kHz, 8-bit tone
	  at 330 Hz * (slot + 1) in place of the payload[i] = base + i ramp.
	  Chunk n is the audio for the unit's n-th TX slot of the run, so a
	  missed frame's audio is dropped, never delayed. The log's META
	  record says which payload a unit sent. Rebuild every unit in the
	  run with the same setting, then turn any unit's log into a WAV of
	  its peers with tools/reconstruct_tone.py. See
	  docs/tone_payload_test.md.

config SOAK_RTT
	bool "Soak bench port over J-Link RTT"
	default y
	depends on APP_TDMA_CONSOLE || APP_TDMA_FIELD
	select USE_SEGGER_RTT
	help
	  Stream every soak record to the host over J-Link RTT (up channel 1,
	  the same 64 B records the card gets, META first) and take bench
	  commands on down channel 1: status, soak <minutes> [sd], stop.
	  Replies come back on up channel 2. No pins and no USB stack: the
	  DK's on-board J-Link reads the RAM rings over SWD. A soak started
	  from the UI still logs to the card as well; one started by the
	  soak command logs to RTT only unless given "sd". Drive it with
	  tools/rtt_link.py. Channel 0, logging and the console are left
	  alone. With n, the tree builds and behaves as before. See
	  docs/rtt_link_c2_transport.md.

# RTT channel counts for the bench port: up 0 (Zephyr's terminal, unused),
# up 1 records, up 2 replies; down 0, down 1 commands. Parsed before the
# SEGGER module's definitions, so these defaults win.
config SEGGER_RTT_MAX_NUM_UP_BUFFERS
	int
	default 3 if SOAK_RTT

config SEGGER_RTT_MAX_NUM_DOWN_BUFFERS
	int
	default 2 if SOAK_RTT

# Turning RTT on would otherwise also turn on Zephyr's RTT log backend, a
# blocking writer on channel 0 that stalls every log call while no host is
# attached. The shield unit logs to UART; the bench port leaves that alone.
config LOG_BACKEND_RTT
	bool
	default n if SOAK_RTT

# The TDMA engine keeps the radio awake for its whole life (PLL kept locked
# in FS between slots; the TCXO warm-up cost is paid once at init). The
# driver's sleep-when-idle behaviour would also detach/re-attach its DIO1
# handling at runtime, violating the post-init quiescence L2 relies on
# (docs/tdma_layering.md). This definition is parsed before the driver's
# (sourced via Kconfig.zephyr below), so its default wins.
config LORA_SX126X_NATIVE_SLEEP
	bool
	default n

source "Kconfig.zephyr"
