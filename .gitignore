*build*/

# Speech clips: the .c2 files and README are committed; the downloaded OSR
# WAVs and the _ref.wav decodes are regenerated by tools/c2clip.py.
soaks/clips/*.wav
# PCM excerpts for the encode test: regenerate with tools/c2clip.py pcm.
soaks/clips/*.pcm

# Earlier local soak results (pre-2026-10-08), kept off the branch.
soaks/range1/
soaks/rtt/
soaks/wm8960/
__pycache__/

# Mic DSP D1 (tools/mic_dsp_ab.py): the clips regenerate with "make"; the raw
# taps and per-clip WAVs are large. Logs, scores and the A/B WAVs are kept.
soaks/mic_dsp_d1/*.pcm
soaks/mic_dsp_d1/*.raw
soaks/mic_dsp_d1/*_in.wav
soaks/mic_dsp_d1/*_clean.wav
soaks/mic_dsp_d1/*_cond.wav
soaks/mic_dsp_d1/*_raw.wav

# Opus over-the-air runs (docs/opus_payload.md): logs, captures, JSON and the
# 15 s listening files are kept. The 5-minute per-slot decodes and the
# loss-condition A/Bs regenerate with reconstruct_c2.py / loss_conditions.py;
# OpusLive_1030 was the PC monitor's shakedown.
soaks/Opus*/*_slot[0-9].wav
soaks/Opus*/conditions/
soaks/OpusLive_1030/
